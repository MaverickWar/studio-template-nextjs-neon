# The database. Studio creates a Neon database and sets this on Vercel for you.
# Locally, copy the connection string from your Neon project's Connect button.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs sign-in cookies: any long random string. Studio makes one up and sets it on Vercel.
# Without it a key made from DATABASE_URL is used. Locally, make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Your own domain, if the app has one (Vercel's addresses already work).
BETTER_AUTH_URL=

# The owner's own login to the app. Studio fills both in on Vercel and shows them to you in Studio
# (Project settings › App setup). The build makes this account if it isn't there yet.
OWNER_EMAIL=
OWNER_PASSWORD=
