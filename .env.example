# The database. On Vercel, add Neon from the Storage tab and this is set for you.
# Locally, copy the connection string from your Neon project's Connect button.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. Signs sign-in cookies; without it a key made from DATABASE_URL is used.
# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Your own domain, if the app has one (Vercel's addresses already work).
BETTER_AUTH_URL=
